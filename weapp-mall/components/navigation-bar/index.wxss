.navigation-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 100;
  overflow: hidden;
  transition: all .2s ease-in-out;
}

.navigation-bar .navigation-bar__content {
  position: relative;
}

.navigation-bar .navigation-bar__content .back {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}

.navigation-bar .navigation-bar__content .title {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}
